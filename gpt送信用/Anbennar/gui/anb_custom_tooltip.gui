	type FancyTooltip_NationalJournalEntry = FancyTooltipWidgetType { # Change the datamodel wrap to allow for the display of more countries
		
		blockoverride "text" {
		raw_text = "placeholder"
		}
		blockoverride "name" {
			raw_text = "National Journal Entry"
		}

		blockoverride "type" {
			raw_text = ""
		}

		blockoverride "icon_texture" {
			texture = "gfx/interface/main_hud/journal_btn.dds"
		}
		blockoverride "icon_size" {
			size = { 70 70 }
		}
		blockoverride "tooltip_content_after" {	
			dynamicgridbox = { 
				datamodel_wrap = 10
				flipdirection = no
				datamodel = "[Country.MakeScope.GetList('national_journal_entry_list')]"
					item = {
						textbox = {
							#margin_top = 5
							#margin_right = 5
							datacontext = "[Scope.GetCountry]"
							text = "[Country.GetName]"
							align = nobaseline
							autoresize = yes
						}					
					}
			}
		}				
	}

	type FancyTooltip_RegionalJournalEntry = FancyTooltipWidgetType { #This just mimics the look of a concept, as I couldn't pull a concept directly into the tooltip.
		
		blockoverride "text" {
		raw_text = "placeholder"
		}
		blockoverride "name" {
			raw_text = "Regional Journal Entry"
		}

		blockoverride "type" {
			raw_text = ""
		}

		blockoverride "icon_texture" {
			#texture = "gfx/interface/icons/both_small2.dds"
			#texture = "gfx/interface/icons/outliner_je.dds"
			texture = "gfx/interface/icons/war_goals/unification.dds"
			#texture = "gfx/interface/icons/war_goals/secession.dds"
			#texture = "gfx/interface/icons/generic_icons/secession_culture_ongoing.dds"
		}
		blockoverride "icon_size" {
			size = { 50 50 }
		}
		blockoverride "tooltip_content_after" {	
			textbox = {
			#text = "REGIONAL_JOURNAL_ENTRY_LIST_LOC"
			align = nobaseline
			autoresize = yes
						}								
		}				
	}
	type FancyTooltip_DescriptionWithIcon = FancyTooltipWidgetType { #Unused rn as using it would require overwriting the entire cooltip txt which would be bad for intermod compatabilitly. If we ever have more major cooltips to add then this could be used for the religion descriptions tt's.
		blockoverride "text" {
			
		}
		

		blockoverride "name" {
			raw_text = "#yellow [Religion.GetNameNoFormatting]#! Description"
		}
		

		blockoverride "icon_texture" {
			texture = "[Religion.GetTexture]"
		}

		blockoverride "type" {
			text = "TOOLTIP_TYPE_RELIGION"
		}

		blockoverride "go_to_button_visibility" {
			visible = yes
		}

		blockoverride "go_to_button_properties" {
			onclick = "[InformationPanelBar.OpenReligionInfoPanel(Religion.AccessSelf)]"
		}

		blockoverride "tooltip_content_after" 
		{

	}
	}

}


