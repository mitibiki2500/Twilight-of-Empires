                And(
                    LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2',Country.MakeScope.Var('country_max_spell_level').GetValue),
                    EqualTo_string(Scope.GetFlagName,GetPlayer.MakeScope.Var('society_magic_spell').GetFlagName)))]"
            blockoverride "details" {       
                tooltip = "SOCIETY_SPELL_LEVEL_2_TOOLTIP_NOT_ACTIVE"
                onclick = "[GetScriptedGui('society_magic_spell_activate_targeted_level_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                enabled = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2',Country.MakeScope.ScriptValue('country_max_society_magic_level'))]"
            }
        }   
        spell_section_widget_locked = { 
            position = { 114 0 }
            visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)2',Country.MakeScope.Var('country_max_spell_level').GetValue),
            EqualTo_string(Scope.GetFlagName,GetPlayer.MakeScope.Var('society_magic_spell').GetFlagName))]"
            tooltip = "LOCKED_SPELL_LEVEL_TOOLTIP"
        }   	
		
		# Spell Level 3
		spell_section_widget_current_level = { 
			position = { 228 0 }
			visible = "[And(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('society_magic_spell_level_floor').GetValue,'(CFixedPoint)3'),
			EqualTo_string(Scope.GetFlagName,GetPlayer.MakeScope.Var('society_magic_spell').GetFlagName))]"
			tooltip = "SOCIETY_SPELL_LEVEL_3_TOOLTIP_ACTIVE"
		}
        spell_section_widget_chosen = {
            position = { 228 0 }
            visible = "[And(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('society_magic_targeted_spell_level').GetValue,'(CFixedPoint)3'),And(Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('society_magic_spell_level_floor').GetValue,GetPlayer.MakeScope.Var('society_magic_targeted_spell_level').GetValue)),EqualTo_string(Scope.GetFlagName,GetPlayer.MakeScope.Var('society_magic_spell').GetFlagName)))]"
            tooltip = "SOCIETY_SPELL_LEVEL_3_TOOLTIP_NOT_ACTIVE"
        }
		spell_section_widget_not_selected = { 
			position = { 228 0 }
			visible = "[And(
				Not(Or(
					EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('society_magic_spell_level_floor').GetValue,'(CFixedPoint)3'),
					EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('society_magic_targeted_spell_level').GetValue,'(CFixedPoint)3')
					)),
				And(
					LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3',Country.MakeScope.Var('country_max_spell_level').GetValue),
					EqualTo_string(Scope.GetFlagName,GetPlayer.MakeScope.Var('society_magic_spell').GetFlagName)))]"
			blockoverride "details" {		
				tooltip = "SOCIETY_SPELL_LEVEL_3_TOOLTIP_NOT_ACTIVE"
				onclick = "[GetScriptedGui('society_magic_spell_activate_targeted_level_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				enabled = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3',Country.MakeScope.ScriptValue('country_max_society_magic_level'))]"
			}
		}	
		spell_section_widget_locked = { 
			position = { 228 0 }
			visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)3',Country.MakeScope.Var('country_max_spell_level').GetValue),
			EqualTo_string(Scope.GetFlagName,GetPlayer.MakeScope.Var('society_magic_spell').GetFlagName))]"
			tooltip = "LOCKED_SPELL_LEVEL_TOOLTIP"
		}	
		
		# Spell Level 4
        spell_section_widget_current_level = { 
